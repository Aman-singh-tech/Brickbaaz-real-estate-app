DATABASE_URL="postgresql://user:pass@localhost:5432/dbname?schema=public"
SESSION_SECRET="long-random-string"
# Public URL of the site (used in email links and the Google redirect URI). Optional in dev.
# APP_URL="https://www.example.com"
# Serve the owner app on its own hostname (needs APP_URL too). Unset = both apps on one host.
# OWNER_HOST="owner.example.com"

# The single owner account for the owner app (/owner)
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD="change-me-to-a-long-password"
OWNER_NAME="Owner Name"
# Public desk number shown to buyers for call / WhatsApp
OWNER_PHONE="9999900000"
SUPPORT_PHONE="1800-BRICK-IN"

# Google sign-in (https://console.cloud.google.com > APIs & Services > Credentials > OAuth client ID, type Web).
# Authorised redirect URI: <APP_URL>/api/auth/google/callback  (dev: http://localhost:3000/api/auth/google/callback)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Transactional email for verification + password reset (https://resend.com). Without it, links are logged / shown in dev only.
# RESEND_API_KEY=""
# EMAIL_FROM="Brickbaaz <noreply@yourdomain.com>"

# Future: phone OTP (see lib/otp.js)
# OTP_PROVIDER="msg91"
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""

# Photo/video storage (https://cloudinary.com > Dashboard > API Keys). Without these, uploads go to local ./uploads (dev only).
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

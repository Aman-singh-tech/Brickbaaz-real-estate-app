// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Brickbaaz ----------

enum Role {
  BUYER
  OWNER
}

enum Purpose {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  VILLA
  BUILDER_FLOOR
  PLOT
  COMMERCIAL
}

enum PropertyStatus {
  DRAFT
  ACTIVE
  PAUSED
  RENTED
  SOLD
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum InquiryKind {
  VISIT
  CALLBACK
  MESSAGE
}

enum Sender {
  BUYER
  OWNER
}

model User {
  id            Int            @id @default(autoincrement())
  phone         String?        @unique
  email         String?        @unique
  passwordHash  String?
  googleId      String?        @unique
  emailVerified Boolean        @default(false)
  name          String?
  role          Role           @default(BUYER)
  createdAt     DateTime       @default(now())
  properties    Property[]
  inquiries     Inquiry[]
  saved         Saved[]
  notifications Notification[]
  tokens        EmailToken[]
  savedProjects SavedProject[]
}

enum TokenKind {
  VERIFY
  RESET
}

model EmailToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      TokenKind
  hash      String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId, kind])
}

// Kept for a future phone-OTP login (see lib/otp.js).
model Otp {
  id        Int      @id @default(autoincrement())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Property {
  id            Int            @id @default(autoincrement())
  ownerId       Int
  owner         User           @relation(fields: [ownerId], references: [id])
  status        PropertyStatus @default(DRAFT)
  purpose       Purpose
  type          PropertyType
  title         String
  city          String
  state         String?
  locality      String
  society       String?
  lat           Float?
  lng           Float?
  bedrooms      Int?
  bathrooms     Int?
  balconies     Int?
  carpetArea    Int?
  superArea     Int?
  floor         Int?
  totalFloors   Int?
  furnishing    String?
  facing        String?
  possession    String?
  possessionBy  String?
  amenities     String[]
  nearby        Json?
  description   String?
  reraId        String?
  price         Int
  negotiable    Boolean        @default(false)
  deposit       Int?
  featured      Boolean        @default(false)
  views         Int            @default(0)
  publishedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  media         Media[]
  inquiries     Inquiry[]
  saved         Saved[]

  @@index([status, purpose, city])
}

model Media {
  id         Int       @id @default(autoincrement())
  propertyId Int
  property   Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind       MediaKind
  url        String
  sort       Int       @default(0)
}

model Inquiry {
  id         Int         @id @default(autoincrement())
  propertyId Int
  property   Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     Int
  user       User        @relation(fields: [userId], references: [id])
  kind       InquiryKind
  visitAt    DateTime?
  phone      String
  note       String?
  handled    Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  messages   Message[]

  @@index([propertyId])
  @@index([userId])
}

model Message {
  id        Int      @id @default(autoincrement())
  inquiryId Int
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  sender    Sender
  body      String
  createdAt DateTime @default(now())
}

model Saved {
  userId     Int
  propertyId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, propertyId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum LeadStage {
  NEW
  CONTACTED
  VISIT_SCHEDULED
  VISIT_COMPLETED
  NEGOTIATION
  BOOKED
  LOST
}
model Builder {
  id Int @id @default(autoincrement())
  name String @unique
  description String?
  projects Project[]
}
model Project {
  id Int @id @default(autoincrement())
  slug String @unique
  name String
  builderId Int
  builder Builder @relation(fields: [builderId], references: [id])
  status ProjectStatus @default(DRAFT)
  city String
  state String?
  locality String
  lat Float?
  lng Float?
  reraId String?
  possession String
  possessionDate String?
  description String?
  amenities String[]
  paymentPlan String?
  featured Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  configurations Configuration[]
  assets ProjectAsset[]
  leads ProjectLead[]
  saved SavedProject[]
  @@index([status, city])
}
model Configuration {
  id Int @id @default(autoincrement())
  projectId Int
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label String
  bedrooms Int?
  area Int
  price Decimal? @db.Decimal(14, 2)
  floorPlan String?
}
model ProjectAsset {
  id Int @id @default(autoincrement())
  projectId Int
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind String
  url String
  sort Int @default(0)
}
model ProjectLead {
  id Int @id @default(autoincrement())
  projectId Int
  project Project @relation(fields: [projectId], references: [id])
  name String
  phone String
  email String?
  kind String
  stage LeadStage @default(NEW)
  visitAt DateTime?
  pickupAddress String?
  followUpAt DateTime?
  consentAt DateTime
  source String?
  campaign String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes LeadNote[]
  @@index([stage, followUpAt])
}
model LeadNote {
  id Int @id @default(autoincrement())
  leadId Int
  lead ProjectLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body String
  createdAt DateTime @default(now())
}
model SavedProject {
  userId Int
  projectId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, projectId])
}

model CrmLead {
  id Int @id @default(autoincrement())
  name String
  phone String
  email String?
  type String
  interest String
  message String?
  source String @default("website")
  campaign String?
  stage String @default("NEW")
  amount Decimal? @db.Decimal(14,2)
  propertyId Int?
  projectId Int?
  inquiryId Int? @unique
  projectLeadId Int? @unique
  followUpAt DateTime?
  visitAt DateTime?
  consentAt DateTime?
  importedBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  activities CrmActivity[]
  @@index([stage, followUpAt])
  @@index([phone])
  @@index([type, source])
}

model CrmActivity {
  id Int @id @default(autoincrement())
  leadId Int
  lead CrmLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  body String
  createdAt DateTime @default(now())
}

model Testimonial {
  id Int @id @default(autoincrement())
  name String
  feedback String
  reference String?
  imageUrl String?
  videoUrl String?
  published Boolean @default(false)
  sort Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
